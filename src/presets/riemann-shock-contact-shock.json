{
  "format": "shaderous-setup",
  "version": 1,
  "id": "riemann-shock-contact-shock",
  "name": "Riemann problem: Shock, contact, shock",
  "group": "Shocks and blasts",
  "family": "riemann",
  "familyName": "Riemann problems",
  "variant": "Shock, contact, shock",
  "blurb": "Two streams at equal pressure meeting head on at speed 1: two shocks move out, with a contact between them where the density jumps.",
  "domain": {
