    "bc": {
      "lo": [1, 1, 1],
      "hi": [1, 1, 1]
    }
  },
  "physics": {
    "eos": "ideal",
    "eosParams": {
      "gamma": 1.4
    },
    "gravity": "off",
    "G": 0,
    "floors": {
      "p": 1e-12
    }
  },
  "background": {
    "rho": 1.25,
    "p": 1,
    "v": [-0.5, 0, 0]
  },
  "parts": [
    {
      "kind": "region",
      "id": "left",
      "shape": {
        "type": "half",
        "normal": [1, 0, 0],
        "at": 0
      },
      "rho": 1,
      "p": 1,
      "v": [0.5, 0, 0],
      "s": 1
    }
  ],
  "run": {
    "tEnd": 0.3,
    "checkpointDt": 0.03
  },
  "view": {
    "mode": "slice",
    "log": false
  }
}
