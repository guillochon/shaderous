{
  "format": "shaderous-setup",
  "version": 1,
  "id": "field-loop",
  "name": "Field loop advection",
  "group": "Magnetic fields",
  "family": "field-loop",
  "familyName": "Field loop advection",
  "variant": "Uniform gas",
  "blurb": "A weak magnetic field loop carried across a periodic box by a uniform flow, back to its start at t = 1 (Gardiner & Stone 2005).",
  "domain": {
    "ndim": 2,
    "n": 256,
    "amr": 0,
    "box": 1,
    "supports2d": true,
    "bc": { "lo": [0, 0, 0], "hi": [0, 0, 0] }
  },
  "physics": {
    "eos": "ideal",
    "eosParams": { "gamma": 1.6666666666666667 },
    "gravity": "off",
    "G": 0,
    "floors": { "rho": 1e-10, "p": 1e-10 }
  },
  "parts": [
    { "kind": "flow", "name": "field-loop" }
  ],
  "run": { "tEnd": 1, "checkpointDt": 0.1 },
  "view": { "mode": "slice", "field": 25, "log": false }
}
