diff --git a/src/radiation/reduction.wgsl b/src/radiation/reduction.wgsl
new file mode 100644
index 0000000..014a319
--- /dev/null
+++ b/src/radiation/reduction.wgsl
@@ -0,0 +1,26 @@
+// The reduction factor r of a cell, for the passes that have no sweep's neighbors at hand (the
+// advection, the diagnostics, the view): from the least optical depth of the cell and its face
+// neighbors, as the sweeps take it (radiation/sweep.wgsl, amr/rad_sweep.wgsl) and RefRad1D.r.
+//
+// Why the neighbors: an opaque cell may run at the true speed of light because its own exchange
+// with its neighbors is diffusion, slower by its optical depth. Beside a transparent cell that is
+// not so. Light streams through their shared face, and a cell that took it at the true speed
+// while the transparent one answers at the reduced speed is not stable (docs/numerics.md
+// section 24: a slab of 100 optical depths a cell in thin gas, at one temperature, left it by
+// half within 100 steps).
+//
+// Requires radiation/common.wgsl and rad_chi_at(c): kappa_R rho of the cell at c, or of the
+// cell a ghost maps to. The cell itself is evaluated last, so a composition that rad_chi_at
+// selects (comp_use) is the cell's own on return.
+fn rad_r_at(c: vec3<i32>, dx: f32, flat: bool) -> f32 {
+  var chi = 3.0e38;
+  if (rad_local_c()) {
+    for (var a = 0; a < 3; a++) {
+      if (a == 2 && flat) { break; }
+      var e = vec3<i32>(0);
+      e[a] = 1;
+      chi = min(chi, min(rad_chi_at(c - e), rad_chi_at(c + e)));
+    }
+  }
+  return rad_reduction(min(chi, rad_chi_at(c)) * dx);
+}
