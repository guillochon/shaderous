{
  "$schema": "https://guillochon.github.io/shaderous/shaderous-setup.schema.json",
  "format": "shaderous-setup",
  "version": 1,
  "name": "Main-sequence star hit by a white dwarf",
  "blurb": "A 0.5 solar mass main-sequence star struck nearly head-on by a 1 solar mass white dwarf on a parabolic orbit. The white dwarf, a hundredth of the star's size, is a point mass. In the star's rest frame.",
  "domain": {
    "ndim": 3,
    "n": 256,
    "amr": 3,
    "box": 4,
    "supports2d": false,
    "bc": { "lo": [3, 3, 3], "hi": [3, 3, 3] },
    "units": { "name": "solar", "length": { "unit": "Rsun", "value": 1 }, "mass": { "unit": "Msun", "value": 1 } }
  },
  "physics": {
    "eos": "ideal",
    "eosParams": { "gamma": 1.6666666666666667 },
    "gravity": "isolated",
    "G": "units",
    "composition": "solar",
    "floors": { "rho": 1e-10, "p": 1e-14 },
    "fluff": { "rho": 5e-4, "u": 2.4, "v": 20 },
    "frame": "gas"
  },
  "mesh": { "refineMasses": true },
  "background": { "rho": 1e-7, "cut": 2e-6, "relativeTo": "star" },
  "parts": [
    { "kind": "star", "id": "star", "type": "polytrope", "n": 3, "mass": 0.5, "radius": 0.5 },
    { "kind": "mass", "id": "wd", "gm": 1, "soft": 0.05, "sink": 0 },
    { "kind": "orbit", "id": "orbit", "of": ["star", "wd"], "type": "flyby", "q": 2, "beta": 4, "start": 2.5 }
  ],
  "run": { "tEnd": null, "checkpointDt": 0.25, "tDyn": 0.5 },
  "view": { "field": 0, "log": true, "mode": "volume", "pitch": 1.15 }
}
