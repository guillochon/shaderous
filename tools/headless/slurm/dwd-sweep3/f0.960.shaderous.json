    "eosParams": {
      "gamma": 1.6666666666666667
    },
    "gravity": "isolated",
    "G": "units",
    "composition": "carbonOxygen",
    "floors": {
      "rho": 1e-10,
      "p": 1e-14
    },
    "fluff": {
      "rho": 9.999999999999999e-06,
